# --- Resend ---
RESEND_API_KEY=
# Optionnel : expéditeurs (domaine/sous-domaine vérifié dans Resend)
EMAIL_FROM_AUTH="Alluvicare <auth@alluvihealthcareuk.store>"
EMAIL_FROM_ORDERS="Alluvicare <orders@alluvihealthcareuk.store>"
